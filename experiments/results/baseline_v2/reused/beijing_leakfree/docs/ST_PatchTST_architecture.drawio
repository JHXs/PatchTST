        <mxCell id="e3" value="中心站" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="split" target="center"><mxGeometry relative="1" as="geometry" /></mxCell>
