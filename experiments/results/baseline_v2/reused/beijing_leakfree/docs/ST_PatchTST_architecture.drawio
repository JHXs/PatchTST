<mxfile host="app.diagrams.net" modified="2026-05-29T00:00:00.000Z" agent="pi-coding-agent" version="24.7.17" type="device">
  <diagram id="st-patchtst-architecture" name="ST-PatchTST Architecture">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="ST-PatchTST 模型结构（中心站主干 + 邻站门控残差增强 + PatchTST 时间预测）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="1320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="legend_data" value="数据/张量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2e6f9e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1190" y="80" width="110" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend_spatial" value="空间邻站分支" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#c77700;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1310" y="80" width="120" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend_temporal" value="PatchTST 主干" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1440" y="80" width="120" height="32" as="geometry" />
        </mxCell>

        <mxCell id="x" value="输入 X&lt;br&gt;[B, S*F, L]&lt;br&gt;S=站点数, F=特征数, L=历史长度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2e6f9e;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="reshape" value="Reshape&lt;br&gt;[B, S, F, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2e6f9e;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="200" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="split" value="按 center_station_idx 拆分" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2e6f9e;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="450" y="185" width="150" height="95" as="geometry" />
        </mxCell>
        <mxCell id="center" value="中心站 x_c&lt;br&gt;[B, F, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2e6f9e;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="660" y="145" width="155" height="65" as="geometry" />
        </mxCell>
        <mxCell id="neighbors" value="邻站 x_n&lt;br&gt;[B, S-1, F, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2e6f9e;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="660" y="295" width="155" height="65" as="geometry" />
        </mxCell>

        <mxCell id="neighbor_group" value="邻站空间增强分支" style="swimlane;html=1;startSize=30;horizontal=1;whiteSpace=wrap;rounded=1;fillColor=#fff7e8;strokeColor=#c77700;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="265" width="620" height="285" as="geometry" />
        </mxCell>
        <mxCell id="n_reshape" value="重排邻站&lt;br&gt;[B*(S-1), F, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#c77700;fontSize=13;" vertex="1" parent="neighbor_group">
          <mxGeometry x="25" y="60" width="145" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_proj" value="共享 1x1 Conv&lt;br&gt;F → H&lt;br&gt;GELU + Dropout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#c77700;fontSize=13;" vertex="1" parent="neighbor_group">
          <mxGeometry x="205" y="50" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_restore" value="恢复邻站维&lt;br&gt;[B, S-1, H, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#c77700;fontSize=13;" vertex="1" parent="neighbor_group">
          <mxGeometry x="385" y="60" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="中心站门控 MLP&lt;br&gt;AvgPool + Flatten&lt;br&gt;F → H → S-1&lt;br&gt;Softmax 得到邻站权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#c77700;fontSize=13;" vertex="1" parent="neighbor_group">
          <mxGeometry x="120" y="165" width="185" height="90" as="geometry" />
        </mxCell>
        <mxCell id="weighted" value="邻站加权求和&lt;br&gt;Σ weight_i * h_i&lt;br&gt;[B, H, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#c77700;fontSize=13;" vertex="1" parent="neighbor_group">
          <mxGeometry x="345" y="165" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_out" value="1x1 Conv&lt;br&gt;H → F&lt;br&gt;neighbor_context&lt;br&gt;[B, F, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#c77700;fontSize=13;" vertex="1" parent="neighbor_group">
          <mxGeometry x="520" y="165" width="85" height="90" as="geometry" />
        </mxCell>

        <mxCell id="alpha" value="可学习 α&lt;br&gt;α = alpha_max * sigmoid(logit)&lt;br&gt;当前训练配置: alpha_max=0.5, alpha_init=0.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8dddd;strokeColor=#b94a48;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="930" y="95" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="fuse" value="残差融合&lt;br&gt;x_enh = x_c + α * neighbor_context&lt;br&gt;[B, F, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="150" width="250" height="85" as="geometry" />
        </mxCell>

        <mxCell id="patch_group" value="PatchTST 时间预测主干（只处理增强后的中心站表示）" style="swimlane;html=1;startSize=30;horizontal=1;whiteSpace=wrap;rounded=1;fillColor=#eef8ea;strokeColor=#3f7f3f;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="635" width="1260" height="245" as="geometry" />
        </mxCell>
        <mxCell id="p_in" value="PatchTST 输入&lt;br&gt;[B, F, L]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="patch_group">
          <mxGeometry x="25" y="85" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="revin" value="RevIN&lt;br&gt;归一化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="patch_group">
          <mxGeometry x="175" y="85" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="unfold" value="ReplicationPad + Unfold&lt;br&gt;patch_len=4, stride=2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="patch_group">
          <mxGeometry x="305" y="80" width="155" height="70" as="geometry" />
        </mxCell>
        <mxCell id="patches" value="Patch 张量&lt;br&gt;[B, F, patch_len, N]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="patch_group">
          <mxGeometry x="495" y="85" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="embed" value="Patch Embedding&lt;br&gt;Linear patch_len → d_model&lt;br&gt;+ 位置编码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="patch_group">
          <mxGeometry x="665" y="75" width="155" height="80" as="geometry" />
        </mxCell>
        <mxCell id="encoder" value="通道独立 Transformer Encoder ×3&lt;br&gt;[B*F, N, d_model]&lt;br&gt;MHA heads=4, FFN 16→128→16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="patch_group">
          <mxGeometry x="850" y="65" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="head" value="Flatten Head&lt;br&gt;d_model*N → pred_len" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="patch_group">
          <mxGeometry x="1090" y="85" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="out_revin" value="RevIN&lt;br&gt;反归一化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2df;strokeColor=#3f7f3f;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="890" y="940" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="y" value="输出 ŷ&lt;br&gt;[B, F, pred_len]&lt;br&gt;预测中心站多变量未来序列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e3f5;strokeColor=#6750a4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="925" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="config" value="训练入口: train_st_patchtst(X, y, splits, preproc_pipe, exp_pipe)&lt;br&gt;参数来源: tsai/data/model_params.npz&lt;br&gt;TSForecaster: batch_size=16, metrics=[rmse, mse, mae], export=ST_PatchTST.pt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="925" width="455" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="x" target="reshape"><mxGeometry relative="1" as="geometry" /></mxCell>
